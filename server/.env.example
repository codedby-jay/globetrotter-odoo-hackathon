# Local development placeholders only. Copy values from the repository root
# `.env.example`. Prisma CLI loads this file. Do not commit real secrets.

DATABASE_URL=postgresql://globetrotter:globetrotter@localhost:5432/globetrotter?schema=public
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
PORT=3001
CLIENT_URL=http://localhost:5173

# Odoo JSON-RPC (optional). Leave blank to run GlobeTrotter without Odoo.
ODOO_URL=
ODOO_DB=
ODOO_USERNAME=
ODOO_PASSWORD=
ODOO_TIMEOUT_MS=10000
