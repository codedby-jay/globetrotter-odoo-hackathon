// GlobeTrotter travel graph — PostgreSQL is the source of truth.
//
// Schema-enforced:
// - Unique email, city.externalId, activity.externalId, trip.shareSlug
// - Decimal(12,2) for money (never Float)
// - Cascades on user/trip/stop delete
// - Composite PK on SavedDestination
//
// PostgreSQL CHECK constraints are added in the initial migration for:
// - trip/stop endDate >= startDate
// - non-negative costs, popularity, duration, and position
//
// Service-layer (cross-table; cannot be a simple CHECK):
// - Stop dates must fall inside the parent trip date range
// - StopActivity.scheduledDate must fall inside the parent stop date range
// - shareSlug is generated in application code on trip create (URL-safe, not the trip id)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum Visibility {
  PRIVATE
  UNLISTED
  PUBLIC
}

enum ActivityType {
  SIGHTSEEING
  FOOD
  NATURE
  CULTURE
  ADVENTURE
  SHOPPING
  NIGHTLIFE
  OTHER
}

enum CostCategory {
  TRANSPORT
  STAY
  ACTIVITY
  MEALS
  OTHER
}

enum ShareEventType {
  VIEW
  COPY
  SHARE
}

model User {
  id                   String    @id @default(uuid())
  email                String    @unique
  passwordHash         String
  name                 String
  photoUrl             String?
  language             String    @default("en")
  role                 Role      @default(USER)
  odooPartnerId        Int?
  passwordResetToken   String?
  passwordResetExpires DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  trips             Trip[]
  savedDestinations SavedDestination[]
}

model SavedDestination {
  userId String
  cityId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  city City @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@id([userId, cityId])
}

model City {
  id          String   @id @default(uuid())
  externalId  String   @unique
  name        String
  country     String
  countryCode String
  region      String?
  latitude    Float
  longitude   Float
  costIndex   Decimal  @default(50) @db.Decimal(5, 2)
  popularity  Int      @default(0)
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  activities Activity[]
  stops      Stop[]
  savedBy    SavedDestination[]

  @@index([name])
  @@index([country])
}

model Activity {
  id          String       @id @default(uuid())
  externalId  String       @unique
  cityId      String?
  name        String
  type        ActivityType @default(OTHER)
  description String?
  imageUrl    String?
  durationMin Int?
  typicalCost Decimal      @default(0) @db.Decimal(12, 2)
  latitude    Float?
  longitude   Float?
  popularity  Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  city      City?          @relation(fields: [cityId], references: [id], onDelete: SetNull)
  instances StopActivity[]

  @@index([cityId])
  @@index([type])
}

model Trip {
  id            String     @id @default(uuid())
  ownerId       String
  name          String
  description   String?
  startDate     DateTime   @db.Date
  endDate       DateTime   @db.Date
  coverPhotoUrl String?
  budgetLimit   Decimal?   @db.Decimal(12, 2)
  currency      String     @default("USD")
  visibility    Visibility @default(PRIVATE)
  shareSlug     String     @unique
  copiedFromId  String?
  odooExpenseId Int?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  owner       User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  copiedFrom  Trip?         @relation("TripCopies", fields: [copiedFromId], references: [id], onDelete: SetNull)
  copies      Trip[]        @relation("TripCopies")
  stops       Stop[]
  expenses    TripExpense[]
  shareEvents ShareEvent[]

  @@index([ownerId])
}

model Stop {
  id            String   @id @default(uuid())
  tripId        String
  cityId        String
  position      Int
  startDate     DateTime @db.Date
  endDate       DateTime @db.Date
  notes         String?
  stayCost      Decimal  @default(0) @db.Decimal(12, 2)
  transportCost Decimal  @default(0) @db.Decimal(12, 2)

  trip       Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  city       City           @relation(fields: [cityId], references: [id], onDelete: Restrict)
  activities StopActivity[]
  expenses   TripExpense[]

  @@index([tripId, position])
}

model StopActivity {
  id                String       @id @default(uuid())
  stopId            String
  activityId        String?
  customName        String?
  customDescription String?
  scheduledDate     DateTime     @db.Date
  startTime         DateTime?    @db.Time(0)
  durationMin       Int?
  cost              Decimal      @default(0) @db.Decimal(12, 2)
  costCategory      CostCategory @default(ACTIVITY)
  position          Int
  notes             String?

  stop     Stop      @relation(fields: [stopId], references: [id], onDelete: Cascade)
  activity Activity? @relation(fields: [activityId], references: [id], onDelete: SetNull)

  @@index([stopId, scheduledDate, position])
}

model TripExpense {
  id         String       @id @default(uuid())
  tripId     String
  stopId     String?
  category   CostCategory
  label      String
  amount     Decimal      @db.Decimal(12, 2)
  incurredOn DateTime?    @db.Date

  trip Trip  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  stop Stop? @relation(fields: [stopId], references: [id], onDelete: SetNull)

  @@index([tripId])
}

model ShareEvent {
  id        String         @id @default(uuid())
  tripId    String
  event     ShareEventType
  createdAt DateTime       @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
}
