# Local development placeholders only. Copy to `.env` and adjust as needed.
# Do not commit real passwords, API keys, or secrets.

DATABASE_URL=postgresql://globetrotter:globetrotter@localhost:5432/globetrotter?schema=public
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
PORT=3001
CLIENT_URL=http://localhost:5173

# Optional AI Trip Assistant (backend only — never put these in React).
# Leave blank to run GlobeTrotter without an AI provider. Smart analysis still works.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
# Optional OpenAI-compatible gateway:
# AI_BASE_URL=https://api.openai.com/v1
# AI_TIMEOUT_MS=15000

# Odoo JSON-RPC (optional). Leave blank to run GlobeTrotter without Odoo.
# The browser never talks to Odoo — only the Express API uses these values.
ODOO_URL=
ODOO_DB=
ODOO_USERNAME=
ODOO_PASSWORD=
ODOO_TIMEOUT_MS=10000
